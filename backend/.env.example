HOST=0.0.0.0
PORT=8765
DEVICE_TOKEN=change-me
YOLO_WEIGHTS=models/yolov8n.pt
YOLO_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=768
QIMING_VISION_CONFIG=config/v2.yaml
QIMING_DEPTH_ENABLED=true
DEPTH_MODEL_PATH=models/depth-anything-v2/depth_anything_v2_vits.pth
DEPTH_CODE_PATH=.tools/depth-anything-v2
DEPTH_UPDATE_INTERVAL_SECONDS=1.0
DEPTH_MAX_AGE_MS=500
DEPTH_INPUT_SIZE=518
DETECTION_CACHE_TTL_SECONDS=15
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3-vl:4b
LLM_TIMEOUT_SECONDS=300
DATABASE_PATH=data/qiming_hat.db
SIMULATION_MODE=false
OCR_ENGINE=rapidocr
ASR_PROVIDER=zipformer
# 固定使用 sherpa-onnx Zipformer Large INT8（CPU）模型
ASR_MODEL=
ASR_TOKENS=models/asr/sherpa-onnx-streaming-zipformer-zh-int8-2025-06-30/tokens.txt
ASR_ENCODER=models/asr/sherpa-onnx-streaming-zipformer-zh-int8-2025-06-30/encoder.int8.onnx
ASR_DECODER=models/asr/sherpa-onnx-streaming-zipformer-zh-int8-2025-06-30/decoder.onnx
ASR_JOINER=models/asr/sherpa-onnx-streaming-zipformer-zh-int8-2025-06-30/joiner.int8.onnx
ASR_NUM_THREADS=2
AUDIO_SESSION_TIMEOUT_SECONDS=8
AUDIO_MAX_CHUNK_BYTES=64000
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_SAMPLE_RATE=16000
TTS_FFMPEG=ffmpeg
# Server REST queries use the CocoMap gateway. Keep its key server-side only.
MAP_SERVICE_MODE=cocomap
COCOMAP_BASE_URL=https://map.culture09.xyz
COCOMAP_API_KEY=
# Optional official browser SDK credentials; a gateway token is NOT a JS key.
MAP_JS_PROVIDER=baidu
BAIDU_MAP_JS_AK=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
# Only used when explicitly selecting MAP_SERVICE_MODE=amap.
AMAP_WEB_KEY=
QIMING_MAP_DEMO_MODE=false
